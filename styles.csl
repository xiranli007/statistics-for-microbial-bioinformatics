<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text">
  <info>
    <title>Numeric minimal</title>
    <id>http://www.zotero.org/styles/numeric-minimal</id>
    <link href="http://www.zotero.org/styles/numeric-minimal" rel="self"/>
    <updated>2026-07-23T00:00:00+00:00</updated>
  </info>
  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography et-al-min="7" et-al-use-first="6">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text variable="title"/>
    </layout>
  </bibliography>
</style>
